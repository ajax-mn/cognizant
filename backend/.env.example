GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash
DATABASE_URL=DATABASE_URL

# Local Ollama fallback configuration (Optional - defaults to localhost:11434 & qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AUTH_USER=username
AUTH_PASS=password

# Query cache configuration (Local Redis or Upstash)
ENABLE_QUERY_CACHE=true
CACHE_INVALIDATION_ON_SCHEMA_CHANGE=true
HAIKU_PRICE_PER_TOKEN=0.0000015

# Option 1: Upstash Redis URL (from Upstash Console -> Details -> 'ioredis' or 'redis-cli' URL)
# REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# Option 2: Separate parameters (local or cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
