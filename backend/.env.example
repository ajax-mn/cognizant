GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/text_to_sql_db

# Query cache configuration
ENABLE_QUERY_CACHE=true
CACHE_INVALIDATION_ON_SCHEMA_CHANGE=true
GEMINI_PRICE_PER_TOKEN=0.000000375

# Local Ollama fallback configuration (Optional - defaults to localhost:11434 & qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

